# Copy this file to .env and set your own values.
# .env is git-ignored; this example is committed.

# PostgreSQL superuser and its password
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Database the API connects to. db/schema.sql creates it on first start,
# so this must match the database name used in schema.sql (ecommerce_db).
POSTGRES_DB=ecommerce_db
